---
import { sql } from 'drizzle-orm';

import AdminNav from '../../components/AdminNav.astro';
import { db, leads, talentApplications } from '../../db';
import '../../styles/admin.css';

// Guarded by src/middleware.ts (#52) — Astro.locals.user is always set by
// the time this page renders (the guard 403s otherwise, since there is no
// app-level login page to redirect to anymore). The check below is just
// defensive/type-narrowing, not a second auth boundary.
const user = Astro.locals.user;
if (!user) {
  return new Response('Forbidden', { status: 403 });
}

// Simple totals for the landing cards — no filtering, just "how many
// rows exist" as an at-a-glance count. The real lists (with search +
// filters) live at /admin/leads and /admin/applications.
const [{ value: leadsCount }] = await db
  .select({ value: sql<number>`count(*)`.mapWith(Number) })
  .from(leads);
const [{ value: applicationsCount }] = await db
  .select({ value: sql<number>`count(*)`.mapWith(Number) })
  .from(talentApplications);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Admin — Zyeth</title>
  </head>
  <body>
    <div class="admin-shell">
      <AdminNav email={user.email} />
      <h1>Dashboard</h1>
      <div class="admin-card-row">
        <div class="admin-card">
          <a href="/admin/leads">
            <h2>Leads</h2>
            <div class="admin-card-count">{leadsCount}</div>
          </a>
        </div>
        <div class="admin-card">
          <a href="/admin/applications">
            <h2>Applications</h2>
            <div class="admin-card-count">{applicationsCount}</div>
          </a>
        </div>
      </div>
    </div>
  </body>
</html>
