---
import { eq } from 'drizzle-orm';

import { db, users } from '../../db';
import { payDummyHashingCost, verifyPassword } from '../../lib/auth';
import { ensureCsrfToken, verifyCsrfToken } from '../../lib/csrf';
import { checkLoginRateLimit, getClientIp } from '../../lib/rate-limit';
import { createSession } from '../../lib/session';

// Admin login (#30). This page handles BOTH GET (render the form) and
// POST (verify credentials) at the same URL — see src/middleware.ts,
// which exempts exactly this path from the session guard so it stays
// reachable while logged out.
//
// Admin UI is English-only by design (epic scope) — no i18n here, unlike
// the public marketing site.

let error: string | null = null;

if (Astro.request.method === 'POST') {
  const ip = getClientIp(Astro.request, Astro.clientAddress);

  if (!checkLoginRateLimit(ip)) {
    error = 'Too many attempts. Please try again later.';
  } else {
    const form = await Astro.request.formData();
    const csrfToken = form.get('csrfToken');
    const email = form.get('email');
    const password = form.get('password');

    if (!verifyCsrfToken(Astro.cookies, typeof csrfToken === 'string' ? csrfToken : undefined)) {
      error = 'Invalid credentials';
    } else if (typeof email !== 'string' || typeof password !== 'string' || !email || !password) {
      error = 'Invalid credentials';
    } else {
      const rows = await db
        .select()
        .from(users)
        .where(eq(users.email, email.trim().toLowerCase()))
        .limit(1);
      const user = rows[0];

      let ok = false;
      if (user) {
        ok = await verifyPassword(user.passwordHash, password);
      } else {
        // No matching user — still pay the hashing cost so this branch
        // doesn't respond measurably faster (email-enumeration guard).
        await payDummyHashingCost(password);
      }

      if (ok && user) {
        await createSession(Astro.cookies, user.id);
        return Astro.redirect('/admin');
      }

      // Deliberately generic — never reveal whether the email or the
      // password was the wrong part.
      error = 'Invalid credentials';
    }
  }
}

const csrfToken = ensureCsrfToken(Astro.cookies);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Admin Login — Zyeth</title>
  </head>
  <body>
    <main style="max-width: 24rem; margin: 4rem auto; font-family: system-ui, sans-serif;">
      <h1>Zyeth Admin</h1>
      {error && (
        <p role="alert" style="color: #b91c1c;">{error}</p>
      )}
      <form method="POST" style="display: grid; gap: 0.75rem;">
        <input type="hidden" name="csrfToken" value={csrfToken} />
        <label>
          Email
          <input type="email" name="email" required autocomplete="username" style="display: block; width: 100%;" />
        </label>
        <label>
          Password
          <input
            type="password"
            name="password"
            required
            autocomplete="current-password"
            style="display: block; width: 100%;"
          />
        </label>
        <button type="submit">Sign in</button>
      </form>
    </main>
  </body>
</html>
