---
import { eq } from 'drizzle-orm';

import AdminNav from '../../../components/AdminNav.astro';
import { db, talentApplications } from '../../../db';
import { ensureCsrfToken } from '../../../lib/csrf';
import '../../../styles/admin.css';

// Guarded by src/middleware.ts — see admin/index.astro for why this
// check is defensive, not a second auth boundary.
const user = Astro.locals.user;
if (!user) {
  return Astro.redirect('/admin/login');
}

const { id } = Astro.params;
const rows = id
  ? await db.select().from(talentApplications).where(eq(talentApplications.id, id)).limit(1)
  : [];
const application = rows[0];

if (!application) {
  return Astro.redirect('/admin/applications');
}

const csrfToken = ensureCsrfToken(Astro.cookies);
const dateFormatter = new Intl.DateTimeFormat('en-US', { dateStyle: 'medium', timeStyle: 'short' });
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Application — Zyeth Admin</title>
  </head>
  <body>
    <div class="admin-shell">
      <AdminNav email={user.email} csrfToken={csrfToken} />
      <a class="admin-back-link" href="/admin/applications">← Back to applications</a>
      <h1>{application.name}</h1>
      <div class="admin-detail">
        <dl>
          <dt>Name</dt>
          <dd>{application.name}</dd>
          <dt>Email</dt>
          <dd>{application.email}</dd>
          <dt>Role experience</dt>
          <dd>{application.roleExperience}</dd>
          <dt>English level</dt>
          <dd>{application.englishLevel}</dd>
          <dt>Status</dt>
          <dd>{application.status}</dd>
          <dt>CV file</dt>
          <dd>{application.cvOriginalName}</dd>
          <dt>Created</dt>
          <dd>{dateFormatter.format(application.createdAt)}</dd>
        </dl>
      </div>
      <a class="admin-cv-download" href={`/admin/applications/${application.id}/cv`}>
        Download CV
      </a>
    </div>
  </body>
</html>
