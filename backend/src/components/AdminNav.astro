---
// Shared top nav for every authenticated /admin/* page (#31). Pulled out
// of index.astro so the dashboard, leads, and applications pages don't
// each hand-roll the same links + logout link.
//
// Logout is a plain GET link (#52) — identity is entirely owned by
// Cloudflare Access now, so there is no app-level session to destroy via
// a POST, and thus no CSRF token to carry here (see src/lib/csrf.ts).
interface Props {
  email: string;
}

const { email } = Astro.props;
---

<nav class="admin-nav">
  <a href="/admin">Dashboard</a>
  <a href="/admin/leads">Leads</a>
  <a href="/admin/applications">Applications</a>
  <span class="admin-nav-spacer"></span>
  <span class="admin-nav-user">Signed in as {email}</span>
  <a href="/admin/logout">Log out</a>
</nav>
