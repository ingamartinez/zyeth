---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
---

<Layout>
  <Nav />
  <main class="mx-auto flex min-h-[50vh] max-w-7xl flex-col items-start justify-center px-4 py-24 sm:px-6">
    <p class="eyebrow text-brand-teal">Curated talent</p>
    <h1 class="mt-3 max-w-3xl text-4xl sm:text-5xl">
      Foundation ready — hero lands next.
    </h1>
    <p class="mt-4 max-w-xl text-lg text-muted">
      Design tokens, layout, i18n (EN/ES), nav and footer are in place.
    </p>
  </main>
  <Footer />
</Layout>
