---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import PageHero from "../components/PageHero.astro";
import AboutIntro from "../components/AboutIntro.astro";
import AboutMission from "../components/AboutMission.astro";
import AboutVetting from "../components/AboutVetting.astro";
import CtaBand from "../components/CtaBand.astro";
import Footer from "../components/Footer.astro";
import { useTranslations, getLangFromUrl } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout
  title={`${t("site.name")} — ${t("about.meta.title")}`}
  description={t("about.meta.description")}
>
  <Nav />
  <main>
    <PageHero
      eyebrowKey="about.hero.eyebrow"
      headingKey="about.hero.h1"
      subtitleKey="about.hero.subtitle"
    />
    <AboutIntro />
    <AboutMission />
    <AboutVetting />
    <CtaBand headingKey="about.cta.heading" bodyKey="about.cta.body" />
  </main>
  <Footer />
</Layout>
