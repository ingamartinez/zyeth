---
import { getLangFromUrl, useTranslations, localizePath } from "../i18n/utils";
import Button from "./Button.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const bookACall = localizePath("/#contact", lang);
---

<section class="cta-band" aria-labelledby="cta-band-heading">
  <div class="cta-band-wrap mx-auto max-w-7xl px-4 sm:px-6">
    <h2 id="cta-band-heading" class="cta-band-heading">{t("howitworks.cta.heading")}</h2>
    <p class="cta-band-body">{t("howitworks.cta.body")}</p>
    <Button href={bookACall} variant="primary" size="lg">{t("nav.cta")}</Button>
  </div>
</section>

<style>
  .cta-band {
    background: var(--color-brand-green-dark);
    color: var(--color-near-white);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }
  .cta-band-wrap {
    padding-top: 64px;
    padding-bottom: 68px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 14px;
    max-width: 640px;
    margin-left: auto;
    margin-right: auto;
  }
  .cta-band-heading {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.5rem, 3vw, 2rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: #fff;
    margin: 0;
  }
  .cta-band-body {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-near-white);
    opacity: 0.82;
    margin: 0 0 8px;
  }

  @media (max-width: 560px) {
    .cta-band-wrap {
      padding-top: 48px;
      padding-bottom: 52px;
    }
  }
</style>
