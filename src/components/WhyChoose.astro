---
import { getLangFromUrl, useTranslations, localizePath } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const bookACall = localizePath("/#contact", lang);

const points = [
  { icon: "curated", title: t("whychoose.point1.title"), body: t("whychoose.point1.body") },
  { icon: "clock", title: t("whychoose.point2.title"), body: t("whychoose.point2.body") },
  { icon: "shield", title: t("whychoose.point3.title"), body: t("whychoose.point3.body") },
] as const;
---

<section class="why" aria-labelledby="why-heading">
  <div class="why-wrap mx-auto max-w-7xl px-4 sm:px-6">
    <div class="why-grid">
      <figure class="why-figure reveal" style="--i:0">
        <img
          class="why-img"
          src="/images/why-choose.jpg"
          alt={t("whychoose.imageAlt")}
          width="1500"
          height="1000"
          loading="lazy"
          decoding="async"
        />
      </figure>

      <div class="why-copy">
        <span class="why-eyebrow reveal" style="--i:1">{t("whychoose.eyebrow")}</span>
        <h2 id="why-heading" class="why-title reveal" style="--i:2">
          {t("whychoose.heading")}
        </h2>
        <p class="why-intro reveal" style="--i:3">{t("whychoose.intro")}</p>

        <ul class="why-points">
          {
            points.map((point, i) => (
              <li class="point reveal" style={`--i:${4 + i}`}>
                <span class="point-ic" aria-hidden="true">
                  {point.icon === "curated" && (
                    <svg viewBox="0 0 24 24" fill="none">
                      <path d="M12 2.5l2.4 1.7 2.9-.2 1 2.7 2.4 1.6-.7 2.8 1 2.8-2.4 1.6-1 2.7-2.9-.2L12 21.5l-2.4-1.7-2.9.2-1-2.7-2.4-1.6 1-2.8-1-2.8 2.4-1.6 1-2.7 2.9.2z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
                      <path d="M8.6 12l2.2 2.2 4.4-4.4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  )}
                  {point.icon === "clock" && (
                    <svg viewBox="0 0 24 24" fill="none">
                      <circle cx="12" cy="12" r="8.5" stroke="currentColor" stroke-width="1.7" />
                      <path d="M12 7.5V12l3 2" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  )}
                  {point.icon === "shield" && (
                    <svg viewBox="0 0 24 24" fill="none">
                      <path d="M12 2.5l7 2.6v5.2c0 4.6-3 8-7 9.2-4-1.2-7-4.6-7-9.2V5.1z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" />
                      <path d="M8.8 12l2.2 2.2 4.2-4.4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  )}
                </span>
                <div class="point-text">
                  <h3 class="point-title">{point.title}</h3>
                  <p class="point-body">{point.body}</p>
                </div>
              </li>
            ))
          }
        </ul>

        <div class="why-cta reveal" style="--i:7">
          <a class="why-btn" href={bookACall}>{t("nav.cta")}</a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const section = document.querySelector<HTMLElement>(".why");
  if (section) {
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const items = section.querySelectorAll<HTMLElement>(".reveal");
    if (reduce || !("IntersectionObserver" in window)) {
      items.forEach((el) => el.classList.add("in"));
    } else {
      const io = new IntersectionObserver(
        (entries, obs) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add("in");
              obs.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.2 },
      );
      items.forEach((el) => io.observe(el));
    }
  }
</script>

<style>
  .why {
    background: var(--color-brand-green-dark);
    color: var(--color-near-white);
  }
  .why-wrap {
    padding-top: 76px;
    padding-bottom: 80px;
  }

  .why-grid {
    display: grid;
    grid-template-columns: 0.92fr 1.08fr;
    gap: 56px;
    align-items: center;
  }

  /* ---------- figure ---------- */
  .why-figure {
    position: relative;
    margin: 0;
  }
  .why-figure::before {
    /* Soft brand glow behind the photo. */
    content: "";
    position: absolute;
    inset: -20px;
    background: radial-gradient(60% 60% at 30% 20%, rgba(43, 175, 163, 0.28), transparent 70%);
    z-index: 0;
    pointer-events: none;
  }
  .why-img {
    position: relative;
    z-index: 1;
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: 22px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow: 0 40px 80px -34px rgba(0, 0, 0, 0.7);
  }

  /* ---------- copy ---------- */
  .why-eyebrow {
    display: inline-block;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-brand-teal);
    margin-bottom: 12px;
  }
  .why-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.6rem, 3.5vw, 2.3rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: #fff;
    margin: 0 0 14px;
  }
  .why-intro {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-near-white);
    opacity: 0.82;
    margin: 0 0 28px;
    max-width: 46ch;
  }

  /* ---------- points ---------- */
  .why-points {
    display: grid;
    gap: 20px;
    margin: 0 0 30px;
    padding: 0;
    list-style: none;
  }
  .point {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 15px;
    align-items: start;
  }
  .point-ic {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border-radius: 12px;
    flex: none;
    color: var(--color-brand-teal);
    background: rgba(43, 175, 163, 0.12);
    border: 1px solid rgba(43, 175, 163, 0.28);
  }
  .point-ic svg {
    width: 22px;
    height: 22px;
  }
  .point-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.0625rem;
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: #fff;
    margin: 3px 0 5px;
  }
  .point-body {
    font-size: 0.92rem;
    line-height: 1.58;
    color: var(--color-near-white);
    opacity: 0.78;
    margin: 0;
  }

  /* ---------- cta ---------- */
  .why-cta {
    display: flex;
  }
  .why-btn {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.97rem;
    border: 0;
    cursor: pointer;
    border-radius: 11px;
    padding: 14px 26px;
    color: #06231f;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 9px;
    background: linear-gradient(135deg, var(--color-brand-teal), var(--color-brand-lime));
    box-shadow: 0 10px 26px -12px rgba(43, 175, 163, 0.8);
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }
  .why-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 16px 30px -12px rgba(43, 175, 163, 0.9);
  }

  /* ---------- motion ---------- */
  .reveal {
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.6s cubic-bezier(0.2, 0.7, 0.2, 1),
      transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
    transition-delay: calc(var(--i, 0) * 0.08s);
  }
  .reveal.in {
    opacity: 1;
    transform: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  /* ---------- responsive ---------- */
  @media (max-width: 900px) {
    .why-grid {
      grid-template-columns: 1fr;
      gap: 36px;
    }
    .why-intro {
      max-width: none;
    }
  }
  @media (max-width: 560px) {
    .why-wrap {
      padding-top: 52px;
      padding-bottom: 56px;
    }
    .why-img {
      border-radius: 18px;
    }
  }
</style>
