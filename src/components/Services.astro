---
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const roles = [
  { icon: "truck", title: t("services.role1.title"), body: t("services.role1.body") },
  { icon: "receipt", title: t("services.role2.title"), body: t("services.role2.body") },
  { icon: "gauge", title: t("services.role3.title"), body: t("services.role3.body") },
  { icon: "headset", title: t("services.role4.title"), body: t("services.role4.body") },
  { icon: "boxes", title: t("services.role5.title"), body: t("services.role5.body") },
  { icon: "chart", title: t("services.role6.title"), body: t("services.role6.body") },
] as const;
---

<section class="services" aria-labelledby="services-heading">
  <div class="services-wrap mx-auto max-w-7xl px-4 sm:px-6">
    <div class="services-head reveal" style="--i:0">
      <span class="services-eyebrow">{t("services.eyebrow")}</span>
      <h2 id="services-heading" class="services-title">{t("services.heading")}</h2>
      <p class="services-intro">{t("services.intro")}</p>
    </div>

    <ul class="services-grid">
      {
        roles.map((role, i) => (
          <li class="card reveal" style={`--i:${i + 1}`}>
            <span class="card-ic" aria-hidden="true">
              {role.icon === "truck" && (
                <svg viewBox="0 0 24 24" fill="none">
                  <path d="M3 6.5h10v9H3zM13 9.5h4l3 3v3h-7z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" />
                  <circle cx="7" cy="17.5" r="1.8" stroke="currentColor" stroke-width="1.7" />
                  <circle cx="16.5" cy="17.5" r="1.8" stroke="currentColor" stroke-width="1.7" />
                </svg>
              )}
              {role.icon === "receipt" && (
                <svg viewBox="0 0 24 24" fill="none">
                  <path d="M6 3.5h12v17l-2.2-1.4-2 1.4-2-1.4-2 1.4-2-1.4L6 20.5z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" />
                  <path d="M9 8h6M9 11.5h6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
                </svg>
              )}
              {role.icon === "gauge" && (
                <svg viewBox="0 0 24 24" fill="none">
                  <path d="M4 16a8 8 0 1116 0" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
                  <path d="M12 16l4-4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
                </svg>
              )}
              {role.icon === "headset" && (
                <svg viewBox="0 0 24 24" fill="none">
                  <path d="M5 13v-1a7 7 0 0114 0v1" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
                  <path d="M4 13.5h2.2v4H5a1.8 1.8 0 01-1.8-1.8v-.4A1.8 1.8 0 015 13.5zM17.8 13.5H20v.4a1.8 1.8 0 01-1.8 1.8H17v-2.2z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" />
                  <path d="M18.5 17.5v.5a3 3 0 01-3 3H12" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
                </svg>
              )}
              {role.icon === "boxes" && (
                <svg viewBox="0 0 24 24" fill="none">
                  <path d="M12 8l4-2.2 4 2.2v4.5L16 14.7 12 12.5z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" />
                  <path d="M4 13l4-2.2 4 2.2v4.5L8 19.7 4 17.5z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" />
                </svg>
              )}
              {role.icon === "chart" && (
                <svg viewBox="0 0 24 24" fill="none">
                  <path d="M4 4v16h16" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
                  <path d="M8 15l3-3 2.5 2L19 8" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              )}
            </span>
            <h3 class="card-title">{role.title}</h3>
            <p class="card-body">{role.body}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .services {
    background: var(--color-brand-green-dark);
    color: var(--color-near-white);
  }
  .services-wrap {
    padding-top: 76px;
    padding-bottom: 80px;
  }

  /* ---------- heading ---------- */
  .services-head {
    max-width: 640px;
    margin-bottom: 40px;
  }
  .services-eyebrow {
    display: inline-block;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-brand-teal);
    margin-bottom: 12px;
  }
  .services-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.6rem, 3.5vw, 2.3rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: #fff;
    margin: 0 0 14px;
  }
  .services-intro {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-near-white);
    opacity: 0.82;
    margin: 0;
  }

  /* ---------- cards ---------- */
  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .card {
    background: #fff;
    border: 1px solid #e3ebe5;
    border-radius: 18px;
    padding: 26px 24px 28px;
    box-shadow: 0 10px 30px -18px rgba(0, 0, 0, 0.45);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .card:hover {
    transform: translateY(-3px);
    box-shadow: 0 18px 40px -20px rgba(0, 0, 0, 0.55);
  }
  .card-ic {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 46px;
    border-radius: 13px;
    color: var(--color-brand-teal);
    background: #e7f4f2;
    border: 1px solid #cfe9e5;
    margin-bottom: 16px;
  }
  .card-ic svg {
    width: 24px;
    height: 24px;
  }
  .card-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.125rem;
    line-height: 1.25;
    letter-spacing: -0.01em;
    color: var(--color-ink);
    margin: 0 0 8px;
  }
  .card-body {
    font-size: 0.92rem;
    line-height: 1.58;
    color: var(--color-muted);
    margin: 0;
  }

  /* ---------- motion ---------- */
  @keyframes services-rise {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  .reveal {
    opacity: 0;
    animation: services-rise 0.6s cubic-bezier(0.2, 0.7, 0.2, 1) forwards;
    animation-delay: calc(var(--i) * 0.08s);
  }
  .card:hover.reveal {
    animation: none;
    opacity: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .reveal {
      animation: none;
      opacity: 1;
    }
    .card {
      transition: none;
    }
    .card:hover {
      transform: none;
    }
  }

  /* ---------- responsive ---------- */
  @media (max-width: 980px) {
    .services-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 620px) {
    .services-grid {
      grid-template-columns: 1fr;
      gap: 14px;
    }
    .services-wrap {
      padding-top: 52px;
      padding-bottom: 56px;
    }
    .services-head {
      margin-bottom: 30px;
    }
  }
</style>
