---
/**
 * "How we curate" section for the About page — light 3-pillar grid explaining
 * the vetting process (the "curated" thread). Structurally modeled on
 * TrustBand.astro's pillar grid, with its own heading/intro (unlike TrustBand,
 * which sits directly under the home hero and keeps its heading sr-only).
 */
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const pillars = [
  {
    icon: "english",
    title: t("about.vetting.pillar1.title"),
    body: t("about.vetting.pillar1.body"),
  },
  {
    icon: "experience",
    title: t("about.vetting.pillar2.title"),
    body: t("about.vetting.pillar2.body"),
  },
  {
    icon: "references",
    title: t("about.vetting.pillar3.title"),
    body: t("about.vetting.pillar3.body"),
  },
] as const;
---

<section class="about-vetting" aria-labelledby="about-vetting-heading">
  <div class="about-vetting-wrap mx-auto max-w-7xl px-4 sm:px-6">
    <div class="about-vetting-head reveal" style="--i:0">
      <span class="about-vetting-eyebrow">{t("about.vetting.eyebrow")}</span>
      <h2 id="about-vetting-heading" class="about-vetting-heading">
        {t("about.vetting.heading")}
      </h2>
      <p class="about-vetting-intro">{t("about.vetting.intro")}</p>
    </div>

    <ul class="about-vetting-grid">
      {
        pillars.map((pillar, i) => (
          <li class="pillar reveal" style={`--i:${i + 1}`}>
            <span class="pillar-ic" aria-hidden="true">
              {pillar.icon === "english" && (
                <svg viewBox="0 0 24 24" fill="none">
                  <path
                    d="M4 5.5h9M4 5.5v13M4 5.5c3 0 4.5 1.5 4.5 4M8.5 9.5c0 3.5-1.7 6.5-4.5 8.3M14 8.5h6M14 12h4.5M14 15.5h6M20 5.5v13"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              )}
              {pillar.icon === "experience" && (
                <svg viewBox="0 0 24 24" fill="none">
                  <rect x="3.5" y="7.5" width="17" height="12" rx="2" stroke="currentColor" stroke-width="1.6" />
                  <path d="M8.5 7.5V6a2 2 0 012-2h3a2 2 0 012 2v1.5" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
                  <path d="M3.5 12.5h17" stroke="currentColor" stroke-width="1.6" />
                </svg>
              )}
              {pillar.icon === "references" && (
                <svg viewBox="0 0 24 24" fill="none">
                  <path
                    d="M12 3l7 2.5v5.2c0 4.6-3 8-7 9.3-4-1.3-7-4.7-7-9.3V5.5z"
                    stroke="currentColor"
                    stroke-width="1.7"
                    stroke-linejoin="round"
                  />
                  <path d="M8.8 12.1l2.2 2.3 4.3-4.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              )}
            </span>
            <div class="pillar-txt">
              <h3 class="pillar-title">{pillar.title}</h3>
              <p class="pillar-body">{pillar.body}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  const section = document.querySelector<HTMLElement>(".about-vetting");
  if (section) {
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const items = section.querySelectorAll<HTMLElement>(".reveal");
    if (reduce || !("IntersectionObserver" in window)) {
      items.forEach((el) => el.classList.add("in"));
    } else {
      const io = new IntersectionObserver(
        (entries, obs) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add("in");
              obs.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.2 },
      );
      items.forEach((el) => io.observe(el));
    }
  }
</script>

<style>
  .about-vetting {
    background: var(--color-surface);
  }
  .about-vetting-wrap {
    padding-top: 76px;
    padding-bottom: 80px;
  }

  .about-vetting-head {
    max-width: 640px;
    margin: 0 auto 44px;
    text-align: center;
  }
  .about-vetting-eyebrow {
    display: inline-block;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    /* On --color-surface bg — brand-teal fails 4.5:1 (2.53:1), use the
       on-light token instead (WCAG AA, #13). */
    color: var(--color-brand-teal-text);
    margin-bottom: 12px;
  }
  .about-vetting-heading {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.6rem, 3.5vw, 2.3rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    margin: 0 0 14px;
  }
  .about-vetting-intro {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-muted);
    margin: 0 auto;
  }

  /* ---------- pillars ---------- */
  .about-vetting-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .pillar {
    display: flex;
    gap: 15px;
    background: #fff;
    border: 1px solid #e3ebe5;
    border-radius: 16px;
    padding: 22px 22px 24px;
    box-shadow: 0 1px 0 rgba(10, 42, 37, 0.03);
  }
  .pillar-ic {
    flex: none;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--color-brand-teal);
    background: #e7f4f2;
    border: 1px solid #cfe9e5;
  }
  .pillar-ic svg {
    width: 22px;
    height: 22px;
  }
  .pillar-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.0625rem;
    line-height: 1.25;
    letter-spacing: -0.01em;
    color: var(--color-ink);
    margin: 2px 0 6px;
  }
  .pillar-body {
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--color-muted);
    margin: 0;
  }

  /* ---------- motion ---------- */
  .reveal {
    opacity: 0;
    transform: translateY(16px);
    transition:
      opacity 0.6s cubic-bezier(0.2, 0.7, 0.2, 1),
      transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
    transition-delay: calc(var(--i, 0) * 0.09s);
  }
  .reveal.in {
    opacity: 1;
    transform: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  /* ---------- responsive ---------- */
  @media (max-width: 860px) {
    .about-vetting-grid {
      grid-template-columns: 1fr;
      gap: 12px;
    }
  }
  @media (max-width: 560px) {
    .about-vetting-wrap {
      padding-top: 52px;
      padding-bottom: 56px;
    }
    .about-vetting-head {
      margin-bottom: 32px;
    }
  }
</style>
