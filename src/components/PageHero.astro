---
/**
 * Compact dark-green hero for standalone pages (no candidate card).
 * Mirrors Hero.astro's copy rhythm without the two-column layout.
 */
import type { UIKey } from "../i18n/ui";
import { useTranslations, getLangFromUrl } from "../i18n/utils";

interface Props {
  eyebrowKey: UIKey;
  headingKey: UIKey;
  subtitleKey: UIKey;
}

const { eyebrowKey, headingKey, subtitleKey } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="page-hero">
  <div class="page-hero-wrap mx-auto max-w-7xl px-4 sm:px-6">
    <p class="page-hero-eyebrow reveal d1">{t(eyebrowKey)}</p>
    <h1 class="page-hero-h1 reveal d2">{t(headingKey)}</h1>
    <p class="page-hero-sub reveal d3">{t(subtitleKey)}</p>
  </div>
</section>

<style>
  .page-hero {
    color: var(--color-near-white);
    background:
      radial-gradient(1200px 700px at 78% -10%, rgba(43, 175, 163, 0.2), transparent 60%),
      radial-gradient(900px 600px at 0% 110%, rgba(154, 203, 63, 0.12), transparent 55%),
      linear-gradient(160deg, #08221e 0%, #0c2c27 55%, var(--color-brand-green-dark) 100%);
    overflow-x: clip;
  }

  .page-hero-wrap {
    padding-top: 64px;
    padding-bottom: 64px;
    max-width: 46rem;
  }

  .page-hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.78rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-brand-teal);
    margin-bottom: 18px;
  }
  .page-hero-eyebrow::before {
    content: "";
    width: 26px;
    height: 1.5px;
    background: linear-gradient(90deg, var(--color-brand-teal), transparent);
  }

  .page-hero-h1 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2rem, 4.4vw, 3rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
    text-wrap: balance;
    margin: 0 0 18px;
    color: #fff;
  }

  .page-hero-sub {
    font-size: 1.05rem;
    line-height: 1.62;
    color: #9db3ab;
    margin: 0;
    max-width: 40em;
  }

  /* ---------- motion ---------- */
  @keyframes page-hero-rise {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  .reveal {
    opacity: 0;
    animation: page-hero-rise 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) forwards;
  }
  .d1 {
    animation-delay: 0.05s;
  }
  .d2 {
    animation-delay: 0.15s;
  }
  .d3 {
    animation-delay: 0.25s;
  }
  @media (prefers-reduced-motion: reduce) {
    .reveal {
      animation: none;
      opacity: 1;
    }
  }

  /* ---------- responsive ---------- */
  @media (max-width: 560px) {
    .page-hero-wrap {
      padding-top: 44px;
      padding-bottom: 44px;
    }
  }
</style>
