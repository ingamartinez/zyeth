---
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const pillars = [
  { icon: "clock", title: t("trust.timezone.title"), body: t("trust.timezone.body") },
  { icon: "shield", title: t("trust.vetting.title"), body: t("trust.vetting.body") },
  { icon: "handshake", title: t("trust.model.title"), body: t("trust.model.body") },
] as const;

const industries = [
  t("trust.industry1"),
  t("trust.industry2"),
  t("trust.industry3"),
  t("trust.industry4"),
];
---

<section class="trust" aria-labelledby="trust-heading">
  <h2 id="trust-heading" class="sr-only">{t("trust.aria")}</h2>
  <div class="trust-wrap mx-auto max-w-7xl px-4 sm:px-6">
    <ul class="trust-grid">
      {
        pillars.map((pillar, i) => (
          <li class="pillar reveal" style={`--i:${i}`}>
            <span class="pillar-ic" aria-hidden="true">
              {pillar.icon === "clock" && (
                <svg viewBox="0 0 24 24" fill="none">
                  <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.7" />
                  <path d="M12 7v5l3.2 2" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              )}
              {pillar.icon === "shield" && (
                <svg viewBox="0 0 24 24" fill="none">
                  <path d="M12 3l7 2.4v5.1c0 4.5-3 7.7-7 9.5-4-1.8-7-5-7-9.5V5.4z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" />
                  <path d="M8.6 12.2l2.3 2.3 4.4-4.6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              )}
              {pillar.icon === "handshake" && (
                <svg viewBox="0 0 24 24" fill="none">
                  <path d="M3 8.5l3-1.5 4 3 1.5-.6 4.5 3.6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
                  <path d="M21 8.5l-3-1.5-4.5 3" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
                  <path d="M11.5 12.9l2 1.7 2-1.4 2.5 2" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              )}
            </span>
            <div class="pillar-txt">
              <h3 class="pillar-title">{pillar.title}</h3>
              <p class="pillar-body">{pillar.body}</p>
            </div>
          </li>
        ))
      }
    </ul>

    <div class="industries reveal" style="--i:3">
      <span class="industries-label">{t("trust.industriesLabel")}</span>
      <ul class="industries-list">
        {industries.map((name) => <li>{name}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .trust {
    background: var(--color-surface);
    border-bottom: 1px solid #e3ebe5;
  }
  .trust-wrap {
    padding-top: 64px;
    padding-bottom: 56px;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* ---------- pillars ---------- */
  .trust-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .pillar {
    display: flex;
    gap: 15px;
    background: #fff;
    border: 1px solid #e3ebe5;
    border-radius: 16px;
    padding: 22px 22px 24px;
    box-shadow: 0 1px 0 rgba(10, 42, 37, 0.03);
  }
  .pillar-ic {
    flex: none;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--color-brand-teal);
    background: #e7f4f2;
    border: 1px solid #cfe9e5;
  }
  .pillar-ic svg {
    width: 22px;
    height: 22px;
  }
  .pillar-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.0625rem;
    line-height: 1.25;
    letter-spacing: -0.01em;
    color: var(--color-ink);
    margin: 2px 0 6px;
  }
  .pillar-body {
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--color-muted);
    margin: 0;
  }

  /* ---------- industries strip ---------- */
  .industries {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 18px;
    margin-top: 34px;
    padding-top: 26px;
    border-top: 1px solid #e3ebe5;
  }
  .industries-label {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .industries-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .industries-list li {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.82rem;
    color: var(--color-brand-green);
    background: #eef4ec;
    border: 1px solid #dde8da;
    border-radius: 999px;
    padding: 6px 13px;
  }

  /* ---------- motion ---------- */
  @keyframes trust-rise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  .reveal {
    opacity: 0;
    animation: trust-rise 0.6s cubic-bezier(0.2, 0.7, 0.2, 1) forwards;
    animation-delay: calc(var(--i) * 0.09s);
  }
  @media (prefers-reduced-motion: reduce) {
    .reveal {
      animation: none;
      opacity: 1;
    }
  }

  /* ---------- responsive ---------- */
  @media (max-width: 860px) {
    .trust-grid {
      grid-template-columns: 1fr;
      gap: 12px;
    }
    .trust-wrap {
      padding-top: 44px;
      padding-bottom: 40px;
    }
  }
</style>
